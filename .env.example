# The browser-facing origin; use HTTPS in production, without a trailing slash.
APP_ORIGIN=http://localhost:3000
# Server-to-server API origin. Use HTTPS in production.
AUTH_API_URL=http://localhost:3001
# Optional: only enable behind an ingress that strips and replaces this single-IP header.
# AUTH_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# AUTH_GATEWAY_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
